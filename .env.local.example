# Copy to .env.local and fill in. NEVER commit .env.local.
# Both values are from the Supabase dashboard: Project Settings -> API.

# Project URL (already known for this project):
NEXT_PUBLIC_SUPABASE_URL=https://zgrqegsucbfcqaniddfo.supabase.co

# "anon public" key (safe to expose to the browser; RLS enforces access):
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Service-role / secret key — SERVER-ONLY, no NEXT_PUBLIC_ prefix. Bypasses RLS.
# Used only by the User CRUD "create user" server action to pre-provision a
# profile before that person's first login (Spec 06 §3.3). Dashboard -> Project
# Settings -> API: the "secret" key (sb_secret_...) or the legacy service_role JWT.
# NEVER expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key-here

# Google OAuth — SERVER-ONLY (no NEXT_PUBLIC_). Never commit real values.
# Hosted: Supabase Dashboard → Authentication → Providers → Google.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
SUPABASE_AUTH_GOOGLE_SECRET=your-google-oauth-client-secret

# LiteLLM (OpenAI-compatible gateway) — SERVER-ONLY.
# Team: LEADERSHIP DASHBOARD / VIRKEY.LEADERSHIP_DASHBOARD.NONE.TEST
LITELLM_BASE_URL=http://litellm.amzur.com:4000
LITELLM_API_KEY=your-litellm-virtual-key-here
# Optional model id understood by your LiteLLM gateway (must be allowed for your key):
LITELLM_MODEL=gemini/gemini-2.5-flash
# Optional override for PDF/image extraction (defaults to LITELLM_MODEL):
# LITELLM_VISION_MODEL=gemini/gemini-2.5-flash
